package-lock.json
yarn.lock
node_modules/
dist/

# Local env overrides. NOTE: .env itself is tracked on purpose — it holds only
# the client-safe publishable Supabase values (also committed in netlify.toml).
.env.local
.env.*.local

# Written by scripts/write-deploy-context.mjs during the build and shipped into
# the function bundles by netlify.toml's included_files. Generated per build —
# tracking it would let a stale commit ref describe a fresh deploy.
netlify/lib/deploy-context.json

# Written by scripts/manual/stage0-send.mjs: one record per send (request
# md5/bytes, target, timestamps, HTTP status, raw response). Local evidence,
# read back and transcribed into the plan's record; never committed raw.
.stage0-send/

# OS noise
.DS_Store
Thumbs.db
