# Real stage-0 sender receipts, kept byte for byte as the sender wrote them
# (item 2 classifier plan §5: receipts are exact files, never normalized).
scripts/tests/fixtures/stage0-classify/real/*.json -text
# The verification tooling runs from its blobs and pins them, and bash cannot run a CRLF
# script: LF in every checkout, so a checkout's bytes are the blob's.
scripts/verify/* text eol=lf
